{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ChatPDF: development",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/lib/main.dart",
      "preLaunchTask": "ChatPDF: check development configuration",
      "toolArgs": [
        "--dart-define-from-file=${workspaceFolder}/config/development.json"
      ]
    },
    {
      "name": "ChatPDF: production",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/lib/main.dart",
      "preLaunchTask": "ChatPDF: check production configuration",
      "toolArgs": [
        "--dart-define-from-file=${workspaceFolder}/config/production.json"
      ]
    }
  ]
}
