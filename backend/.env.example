# Public HTTPS termination is handled by your reverse proxy. Never expose SQLite/storage.
DATABASE_PATH=var/chatpdf.sqlite3
DOCUMENT_STORAGE_ROOT=var/documents
# REQUIRED: set a unique random secret of at least 32 bytes, never commit it.
JWT_SECRET_KEY=
JWT_ISSUER=chatpdf-api
JWT_AUDIENCE=chatpdf-mobile
# Ingestion limits and small batch size (1-10 pages).
MAX_PDF_BYTES=52428800
MAX_PDF_PAGES=10000
PDF_VALIDATION_TIMEOUT=30
INGESTION_BATCH_PAGES=3
INGESTION_BATCH_TIMEOUT=180
INGESTION_LEASE_SECONDS=30
# standard: layout/tables and configurable OCR; provision models before serving.
# native: lower-cost text/region extraction, with explicit structure/OCR warnings.
DOCLING_PIPELINE=standard
DOCLING_OCR=false
DOCLING_ARTIFACTS_PATH=

# Structure-aware retrieval pipeline (backend only).
PARSER_FACTORY=chatpdf.pipeline.parsers:DoclingParser
PARSER_REVISION=docling-2.142.1-structured-v1
DOCLING_OCR_ENGINE=tesseract
DOCLING_OCR_LANGUAGES=eng
DOCLING_OCR_FORCE_FULL_PAGE=false
LOW_TEXT_CHARACTERS=40
CHUNK_SIZE=1800
CHUNK_OVERLAP=150
MAX_CHUNK_SIZE=16000

# ollama, openai, custom, or hash-demo (offline lexical demonstration only).
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text:latest
EMBEDDING_REVISION=1
# 0 selects the provider/model default dimensions.
EMBEDDING_DIMENSIONS=0
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT=90
EMBEDDING_TASK_TIMEOUT=300
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional server-only Ollama authentication; never expose to Flutter.
OLLAMA_API_KEY=
# REQUIRED for chat: exact installed tags, including an explicit :tag.
# Choose/provision your Gemma and Kimi variants; there is no automatic fallback.
GEMMA_MODEL_TAG=
KIMI_MODEL_TAG=
OLLAMA_CHAT_TIMEOUT=120
OLLAMA_CHAT_MAX_TOKENS=1024
OLLAMA_CHAT_MAX_INPUT_CHARS=60000
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# Required only for EMBEDDING_PROVIDER=custom; module:factory returns LangChain Embeddings.
EMBEDDING_FACTORY=

# Default: exact cosine vectors persisted transactionally in DATABASE_PATH.
VECTOR_STORE_FACTORY=chatpdf.pipeline.vectorstores:SQLiteVectorStore
VECTOR_STORE_REVISION=1
VECTOR_STORE_NAMESPACE=chatpdf
# Reserved for a custom adapter; keep connection details and secrets on the server.
VECTOR_STORE_URL=
VECTOR_STORE_API_KEY=

# Authenticated one-page previews; longest edge 256-1600px, timeout 1-25 seconds.
PREVIEW_MAX_EDGE=1200
PREVIEW_TIMEOUT=20

# Supervised local server; expose only through a trusted HTTPS reverse proxy.
PORT=10000
# Optional persistent parser-tooling cache:
# HF_HOME=var/cache/huggingface
# SECURITY: Ollama must be backend-only, never directly reachable from Flutter.
